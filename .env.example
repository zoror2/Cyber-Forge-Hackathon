# Generate development values with scripts/dev-env.ps1. All credential fields are empty.
POSTGRES_PASSWORD=
CB_APP_DB_PASSWORD=
MIGRATION_DATABASE_URL=
DATABASE_URL=
CB_CREATE_RUNTIME_ROLE=1
CB_BOOTSTRAP_TENANT=tenant-a
CB_BOOTSTRAP_API_KEY=
CB_TENANT_KMS_KEY=
CB_ENV=dev
CB_SECRETS_BACKEND=local
CB_DEV_TENANT_KEYS=
CB_DEV_ALLOW_PRIVATE=127.0.0.1/32,::1/128
CB_DEV_CA_FILE=data/devcert/cert.pem
CB_LISTEN=127.0.0.1:8080
MOCK_ADDR=127.0.0.1:8081
MOCK_TLS_CERT=data/devcert/cert.pem
MOCK_TLS_KEY=data/devcert/key.pem
AWS_REGION=
# AI is disabled until a tenant is explicitly listed. Keep the key private.
# AI drafter: CB_AI_PROVIDER = bedrock | groq | empty (off). No defaults in code.
CB_AI_PROVIDER=bedrock
CB_AI_MODEL=global.anthropic.claude-sonnet-5-5
CB_AI_DAILY_LIMIT=20
CB_AI_ENABLED_TENANTS=
# bedrock: AWS default credential chain; locally your ~/.aws mounted read-only
CB_BEDROCK_REGION=ap-south-1
AWS_PROFILE=default
AWS_DIR=C:/Users/<you>/.aws
# groq only
GROQ_API_KEY=
# Local browser form; authenticate as apikey / your tenant API key.
CB_UI_ENABLED=1
CB_UI_ORIGIN=http://127.0.0.1:8080
# Email disabled until an operator configures both a relay and tenant routes.
CB_SMTP_ADDR=
CB_SMTP_FROM=
CB_SMTP_USERNAME=
CB_SMTP_PASSWORD=
CB_SMTP_TLS_MODE=starttls
CB_ALERT_EMAIL_ROUTES=
# Optional loopback-only synthetic mailbox executable.
CB_CAPTURE_SMTP_ADDR=127.0.0.1:1025
CB_CAPTURE_HTTP_ADDR=127.0.0.1:8025
# console sessions / accounts
CB_JWT_SECRET=
CB_DEV_MASTER_KEY=
CB_SIGNUP=open
CB_OPERATOR_TOKEN=
