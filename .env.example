# Local development only. Generate values using scripts/dev-env.ps1.
POSTGRES_PASSWORD=
DATABASE_URL=
CONFIGBRIDGE_ADMIN_TOKEN=
CONFIGBRIDGE_MASTER_KEY=
CONFIGBRIDGE_SECRETS_BACKEND=local
CONFIGBRIDGE_FIXTURE_MODE=1
CONFIGBRIDGE_LISTEN=127.0.0.1:8080
# AWS uses the SDK credential chain (role/profile), never vendor keys in YAML.
AWS_REGION=
