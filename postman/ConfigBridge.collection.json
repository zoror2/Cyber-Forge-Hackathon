{
  "info": {
    "name": "ConfigBridge Member B Phase 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Offline fixture demo: run requests 1-11 in order with CONFIGBRIDGE_FIXTURE_MODE=1. All requests inherit admin authentication. Fill the admin token locally only; vendor_token belongs in Postman Vault. No live provider capability is claimed."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 Submit fixture config",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/yaml"
          }
        ],
        "url": "{{base_url}}/configs",
        "body": {
          "mode": "raw",
          "raw": "version: 1\nid: fixture_events\nname: Offline four-record demonstration\nrequest:\n  method: GET\n  url: https://fixture.invalid/events\n  params: {}\n  headers:\n    Accept: application/json\n  timeout_seconds: 5\nauth:\n  type: none\nresponse:\n  items_path: vulnerabilities\npagination:\n  type: none\nschedule:\n  enabled: false\n  interval_seconds: 60\ndestination:\n  entity: event\n  mapping:\n    id:\n      path: cveID\n      required: true\n      transform: string\n    type:\n      constant: known_exploited_vulnerability\n    severity:\n      constant: unknown\n    timestamp:\n      path: dates.added\n      required: true\n      transform: datetime\n      format: '2006-01-02'\n      timezone: UTC\n      precision: date\n    description:\n      path: shortDescription\n      required: true\n      transform: string\nlimits:\n  max_pages: 1\n  max_records: 100\n  max_run_seconds: 10\n  max_response_bytes: 1048576\nretry:\n  max_attempts: 1\n  base_delay_seconds: 1\n  max_backoff_seconds: 1\n"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Draft saved', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { const c = pm.response.json(); pm.environment.set('connector', c.id); pm.environment.set('revision', c.revision); }"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Validate stored config",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/configs/{{connector}}/validate"
      }
    },
    {
      "name": "3 Activate stored revision",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/configs/{{connector}}/activate",
        "body": {
          "mode": "raw",
          "raw": "{\"revision\": {{revision}}}"
        }
      }
    },
    {
      "name": "4 Test connection without writes",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/connectors/{{connector}}/test"
      }
    },
    {
      "name": "5 Run fixture (repeat to check upsert)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/connectors/{{connector}}/run"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Run returned', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200 && pm.environment.get('connector') === 'fixture_events') { const r=pm.response.json(); pm.test('Fixture counters', () => { pm.expect(r.mode).to.eql('fixture'); pm.expect(r.accepted).to.eql(3); pm.expect(r.quarantined).to.eql(1); }); }"
            ]
          }
        }
      ]
    },
    {
      "name": "6 Run history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/runs?connector={{connector}}&limit=100&offset=0"
      }
    },
    {
      "name": "7 Events",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/records/events?source={{connector}}&limit=100&offset=0"
      }
    },
    {
      "name": "8 Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/records/users?limit=100&offset=0"
      }
    },
    {
      "name": "9 Devices",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/records/devices?limit=100&offset=0"
      }
    },
    {
      "name": "10 Quarantine reasons",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/quarantine?connector={{connector}}&limit=100&offset=0"
      }
    },
    {
      "name": "11 Health JSON",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "12 Secret metadata only",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/secrets"
      }
    },
    {
      "name": "13 Provision secret (set Postman Vault value first)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/secrets/{{secret_name}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": \"{{vault:vendor_token}}\",\n  \"allowed_host\": \"{{allowed_host}}\"\n}"
        }
      }
    },
    {
      "name": "Health HTML (admin auth required)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/html"
          }
        ],
        "url": "{{base_url}}/health"
      }
    }
  ]
}
