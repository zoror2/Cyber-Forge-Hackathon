{
  "info": {
    "name": "ConfigBridge Member B - integrated API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Synthetic TLS mock scenarios. Run core flow first. Failure scenarios create/activate their own configs. Isolation folder requires a separately provisioned tenant B and an ID belonging only to tenant A. API keys are local values; vendor keys belong in Vault. No exported credential values."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Core API flow",
      "item": [
        {
          "name": "Submit mock users",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/configs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": 1,\n  \"id\": \"mock_users\",\n  \"name\": \"Synthetic paginated users\",\n  \"request\": {\n    \"method\": \"GET\",\n    \"url\": \"{{vendor_url}}/users\",\n    \"timeout_seconds\": 5,\n    \"allowed_ports\": [8081]\n  },\n  \"auth\": {\n    \"type\": \"none\"\n  },\n  \"items_path\": \"\",\n  \"pagination\": {\n    \"type\": \"page\",\n    \"page_param\": \"page\",\n    \"size_param\": \"per_page\",\n    \"page_size\": 10\n  },\n  \"schedule\": {\n    \"enabled\": false,\n    \"interval_seconds\": 60\n  },\n  \"destination\": {\n    \"entity\": \"user\",\n    \"mapping\": {\n      \"id\": {\n        \"path\": \"id\",\n        \"required\": true,\n        \"transform\": \"string\"\n      },\n      \"name\": {\n        \"path\": \"profile.name\"\n      },\n      \"email\": {\n        \"path\": \"email\"\n      },\n      \"last_login\": {\n        \"path\": \"last_login\",\n        \"transform\": \"datetime\"\n      }\n    }\n  },\n  \"limits\": {\n    \"max_pages\": 10,\n    \"max_records\": 100,\n    \"max_response_bytes\": 1048576,\n    \"max_run_seconds\": 30\n  },\n  \"retry\": {\n    \"max_attempts\": 4,\n    \"base_delay_ms\": 1000,\n    \"max_retry_after_seconds\": 5\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 201',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201){const s=pm.response.json();pm.environment.set('connector',s.id);pm.environment.set('revision',s.revision);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate stored draft",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/configs/{{connector}}/validate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected HTTP 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Activate stored revision",
