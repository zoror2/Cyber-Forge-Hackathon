{
 "info":{"name":"ConfigBridge KEV and AI drafts (explicit external calls)","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"Run deliberately: the draft request sends a reviewed PUBLIC source description to Groq. Preview makes an outbound HTTPS request to public CISA. No customer samples/secrets go to AI. AI must be enabled for the authenticated tenant. Draft remains inactive; this collection never activates it. API key stays in your private local environment."},
 "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{api_key}}","type":"string"}]},
 "item":[
  {"name":"Exposure candidates","request":{"method":"GET","url":"{{base_url}}/exposure"},"event":[{"listen":"test","script":{"exec":["pm.test('Exposure list',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json()).to.be.an('array');});"]}}]},
  {"name":"Available public sources","request":{"method":"GET","url":"{{base_url}}/ai/sources"},"event":[{"listen":"test","script":{"exec":["pm.test('Public sources available',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().some(s=>s.id==='cisa_kev')).to.eql(true);});"]}}]},
  {"name":"Generate CISA draft with Groq","request":{"method":"POST","url":"{{base_url}}/ai/config-draft","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"source_id\":\"cisa_kev\",\"connector_id\":\"postman_kev_draft\",\"external_ai_consent\":true}"}},"event":[{"listen":"test","script":{"exec":["pm.test('Validated proposal only',()=>{pm.response.to.have.status(200);const p=pm.response.json();pm.expect(p.status).to.eql('draft_proposal');pm.expect(p.review_required).to.eql(true);pm.expect(p.config.schedule.enabled).to.eql(false);pm.environment.set('ai_draft_config',JSON.stringify(p.config));pm.environment.set('ai_connector',p.config.id);});"]}}]},
  {"name":"Save proposal as draft","request":{"method":"POST","url":"{{base_url}}/configs","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{{ai_draft_config}}"}},"event":[{"listen":"test","script":{"exec":["pm.test('Saved draft remains inactive',()=>{pm.response.to.have.status(201);const s=pm.response.json();pm.expect(s.status).to.eql('draft');pm.environment.set('ai_revision',s.revision);});"]}}]},
  {"name":"Test exact draft without activation","request":{"method":"POST","url":"{{base_url}}/configs/{{ai_connector}}/test","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"revision\":{{ai_revision}}}"}},"event":[{"listen":"test","script":{"exec":["pm.test('Bounded draft sample',()=>{pm.response.to.have.status(200);const r=pm.response.json();pm.expect(r.mode).to.eql('test');pm.expect(r.outcome).to.eql('success');pm.expect(r.accepted).to.be.above(0);pm.expect(r.accepted).to.be.at.most(100);pm.expect(r.pages).to.eql(1);});"]}}]},
  {"name":"Read tenant AI audit","request":{"method":"GET","url":"{{base_url}}/ai/audit"},"event":[{"listen":"test","script":{"exec":["pm.test('Audited validation',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().some(x=>x.outcome==='draft_validated')).to.eql(true);});"]}}]}
 ]
}
