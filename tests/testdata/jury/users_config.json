{
  "version": 1, "id": "jury_users", "name": "Jury user collection",
  "request": {"method": "GET", "url": "https://jury.example.test/users", "timeout_seconds": 2},
  "auth": {"type": "none"},
  "items_path": "data.users",
  "pagination": {"type": "page", "page_param": "page", "start_page": 1, "size_param": "limit", "page_size": 2},
  "destination": {"class": "user_inventory", "mapping": {
    "user.uid": {"path": "id", "required": true, "transform": "string"},
    "user.name": {"path": "profile.login", "required": true, "transform": "trim"},
    "user.email_addr": {"path": "profile.email", "transform": "string"},
    "user.type_id": {"path": "is_admin", "required": true, "transform": "lookup", "lookup": {"false": "1", "true": "2"}},
    "user.ldap_person.last_login_time": {"path": "last_login", "transform": "datetime"}
  }},
  "schedule": {"enabled": false, "interval_seconds": 900},
  "limits": {"max_response_bytes": 65536, "max_pages": 10, "max_records": 100, "max_run_seconds": 10},
  "retry": {"max_attempts": 2, "base_delay_ms": 1, "max_retry_after_seconds": 2}
}
