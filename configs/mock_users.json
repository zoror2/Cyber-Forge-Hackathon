{
 "version":1,"id":"mock_users","name":"Synthetic paginated users",
 "request":{"method":"GET","url":"https://mockvendor:8081/users","timeout_seconds":5,"allowed_ports":[8081]},
 "auth":{"type":"none"},"items_path":"",
 "pagination":{"type":"page","page_param":"page","size_param":"per_page","page_size":10},
 "schedule":{"enabled":false,"interval_seconds":60},
 "destination":{"class":"user_inventory","mapping":{
  "user.uid":{"path":"id","required":true,"transform":"string"},
  "user.name":{"path":"profile.name"},
  "user.email_addr":{"path":"email"},
  "user.ldap_person.last_login_time":{"path":"last_login","transform":"datetime"},
  "metadata.product.name":{"constant":"Synthetic mock vendor"}
 }},
 "limits":{"max_pages":10,"max_records":100,"max_response_bytes":1048576,"max_run_seconds":30},
 "retry":{"max_attempts":4,"base_delay_ms":1000,"max_retry_after_seconds":5}
}
