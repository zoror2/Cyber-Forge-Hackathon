{
 "version":1,"id":"fixture_events","name":"Synthetic vulnerability findings",
 "request":{"method":"GET","url":"https://fixture.invalid/events","timeout_seconds":5},
 "auth":{"type":"none"},"items_path":"vulnerabilities","pagination":{"type":"none"},
 "schedule":{"enabled":false,"interval_seconds":60},
 "destination":{"class":"vulnerability_finding","mapping":{
  "finding_info.uid":{"path":"cveID","required":true,"transform":"string"},
  "finding_info.title":{"path":"shortDescription","required":true,"transform":"string"},
  "vulnerabilities.0.cve.uid":{"path":"cveID","required":true,"transform":"string"},
  "time":{"path":"dates.added","required":true,"transform":"datetime","format":"2006-01-02","timezone":"UTC"}
 }},
 "limits":{"max_pages":10,"max_records":100,"max_response_bytes":1048576,"max_run_seconds":10},
 "retry":{"max_attempts":1,"base_delay_ms":1,"max_retry_after_seconds":5}
}
