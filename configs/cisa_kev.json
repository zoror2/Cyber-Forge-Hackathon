{
 "version":1,"id":"cisa_kev","name":"CISA Known Exploited Vulnerabilities (live)",
 "request":{"method":"GET","url":"https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json","timeout_seconds":20},
 "auth":{"type":"none"},"items_path":"vulnerabilities","pagination":{"type":"none"},
 "schedule":{"enabled":false,"interval_seconds":86400},
 "destination":{"entity":"event","mapping":{
  "id":{"path":"cveID","required":true,"transform":"string"},
  "type":{"constant":"known_exploited_vulnerability"},
  "severity":{"constant":"unknown"},
  "timestamp":{"path":"dateAdded","required":true,"transform":"datetime","format":"2006-01-02","timezone":"UTC","precision":"date"},
  "description":{"path":"vulnerabilityName","required":true,"transform":"string"},
  "vendor":{"path":"vendorProject","transform":"trim"},
  "product":{"path":"product","transform":"trim"}
 }},
 "limits":{"max_pages":1,"max_records":5000,"max_response_bytes":8388608,"max_run_seconds":60},
 "retry":{"max_attempts":4,"base_delay_ms":1000,"max_retry_after_seconds":60}
}
