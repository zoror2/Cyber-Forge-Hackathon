{
 "version":1,"id":"msgraph_users","name":"Microsoft Entra ID users via Graph (OAuth2 client credentials)","vendor":"Microsoft",
 "request":{"method":"GET","url":"https://graph.microsoft.com/v1.0/users","timeout_seconds":20,
  "params":{"$select":"id,displayName,userPrincipalName,mail,accountEnabled,createdDateTime","$top":"100"},
  "headers":{"Accept":"application/json"}},
 "auth":{"type":"oauth2_client_credentials","secret":"msgraph",
  "token_url":"https://login.microsoftonline.com/your-tenant/oauth2/v2.0/token",
  "client_auth_method":"client_secret_post","scopes":["https://graph.microsoft.com/.default"]},
 "items_path":"value","pagination":{"type":"next_url","next_url_path":"/@odata.nextLink"},
 "schedule":{"enabled":false,"interval_seconds":3600},
 "destination":{"class":"user_inventory","mapping":{
  "user.uid":{"path":"id","required":true,"transform":"string"},
  "user.name":{"path":"displayName","transform":"string"},
  "user.email_addr":{"path":"mail","transform":"string"},
  "metadata.product.name":{"constant":"Microsoft Entra ID"},
  "metadata.product.vendor_name":{"constant":"Microsoft"},
  "unmapped.user_principal_name":{"path":"userPrincipalName","transform":"string"},
  "unmapped.account_enabled":{"path":"accountEnabled"},
  "unmapped.created":{"path":"createdDateTime","transform":"string"}
 }},
 "limits":{"max_pages":20,"max_records":2000,"max_response_bytes":4194304,"max_run_seconds":120},
 "retry":{"max_attempts":3,"base_delay_ms":1000,"max_retry_after_seconds":60}
}
